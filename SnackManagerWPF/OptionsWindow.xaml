<Window x:Class="SnackManagerWPF.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Suppléments" Height="520" Width="500"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize" 
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- STYLE DES OPTIONS (Checkboxes) -->
        <Style x:Key="OptionCardStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border" Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="2" CornerRadius="12" Padding="20">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#10B981" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.FontSize="16" TextElement.FontWeight="SemiBold" TextElement.Foreground="#374151"/>
                                <Border x:Name="IconCheck" Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="Transparent" BorderBrush="#D1D5DB" BorderThickness="2">
                                    <Path x:Name="CheckMark" Data="M 5,12 L 10,17 L 20,6" Stroke="White" StrokeThickness="3" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#ECFDF5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#059669"/>
                                <Setter TargetName="IconCheck" Property="Background" Value="#059669"/>
                                <Setter TargetName="IconCheck" Property="BorderBrush" Value="#059669"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#065F46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE BOUTON VALIDER/ANNULER -->
        <Style x:Key="ModalButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- CONTENEUR PRINCIPAL -->
    <Border Background="White" CornerRadius="20" Margin="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Direction="270" BlurRadius="20" Opacity="0.2" ShadowDepth="5"/>
        </Border.Effect>

        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 0: Titre -->
                <RowDefinition Height="*"/>
                <!-- 1: Options -->
                <RowDefinition Height="Auto"/>
                <!-- 2: QUANTITÉ (Nouveau) -->
                <RowDefinition Height="Auto"/>
                <!-- 3: Boutons -->
            </Grid.RowDefinitions>

            <!-- 1. EN-TÊTE -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,25">
                <TextBlock x:Name="TxtTitrePlat" Text="Options du produit" FontSize="22" FontWeight="Bold" Foreground="#111827" HorizontalAlignment="Center"/>
                <TextBlock Text="Personnalisez votre commande" FontSize="14" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- 2. LISTE DES OPTIONS -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                <CheckBox Name="ChkFrites" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🍟  Avec Frites" Margin="0,0,10,0"/>
                        <Border Background="#D1FAE5" CornerRadius="5" Padding="8,2">
                            <TextBlock Text="+5,00 DH" FontSize="12" Foreground="#059669" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </CheckBox>

                <CheckBox Name="ChkBoisson" Style="{StaticResource OptionCardStyle}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🥤  Avec Boisson" Margin="0,0,10,0"/>
                        <Border Background="#D1FAE5" CornerRadius="5" Padding="8,2">
                            <TextBlock Text="+5,00 DH" FontSize="12" Foreground="#059669" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </CheckBox>
            </StackPanel>

            <!-- 3. SÉLECTEUR DE QUANTITÉ (NOUVEAU) -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,25">
                <TextBlock Text="Quantité :" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="#6B7280" Margin="0,0,20,0"/>

                <!-- Bouton Moins -->
                <Button Content="-" Width="45" Height="45" FontSize="24" FontWeight="Bold"
                        Background="#F3F4F6" Foreground="#374151" BorderThickness="0" Cursor="Hand"
                        Click="BtnMoins_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22.5"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Le Nombre -->
                <TextBlock x:Name="TxtQuantite" Text="1" Width="60" TextAlignment="Center" VerticalAlignment="Center"
                           FontSize="26" FontWeight="ExtraBold" Foreground="#111827"/>

                <!-- Bouton Plus -->
                <Button Content="+" Width="45" Height="45" FontSize="24" FontWeight="Bold"
                        Background="#059669" Foreground="White" BorderThickness="0" Cursor="Hand"
                        Click="BtnPlus_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="22.5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>

            <!-- 4. PIED DE PAGE (BOUTONS) -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Annuler" Background="#F3F4F6" Foreground="#4B5563" Style="{StaticResource ModalButtonStyle}" Click="BtnAnnuler_Click"/>
                <Button Grid.Column="2" Content="Valider" Background="#059669" Foreground="White" Style="{StaticResource ModalButtonStyle}" Click="BtnValider_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>