<Window x:Class="SnackManagerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="JM FOOD - Système de Caisse" Height="850" Width="1300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0F172A">

    <Window.Resources>
        <!-- STYLE DES ONGLETS -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="10" Padding="15,10" Margin="0,0,8,10" BorderThickness="1" BorderBrush="#334155">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#FBBF24"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE BOUTON VALIDER (JAUNE) -->
        <Style x:Key="ValiderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#FBBF24"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE BOUTON SUPPRIMER (ROUGE) -->
        <Style x:Key="SupprimerButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Red"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="12" Padding="15,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- STYLE DU PANIER DARK -->
        <Style x:Key="DarkPanierGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#334155"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="50"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>

        <!-- STYLE DES CELLULES DU PANIER (LA CORRECTION EST ICI) -->
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="5,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,25,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,25">
                <StackPanel Orientation="Horizontal">
                    <Border Width="55" Height="55" CornerRadius="15" Background="#FBBF24" Margin="0,0,15,0">
                        <TextBlock Text="JM" Foreground="Black" FontWeight="Black" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="JM FOOD" FontSize="28" FontWeight="Black" Foreground="White"/>
                        <TextBlock Text="CAISSE DIGITALE" FontSize="12" Foreground="#94A3B8"/>
                    </StackPanel>
                </StackPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ValiderButtonStyle}" Content="🔒 ADMIN" Click="BtnAdmin_Click" Width="100" Height="45" HorizontalAlignment="Right"/>
            </DockPanel>

            <TabControl x:Name="TabMenu" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource ModernTabItem}">
                <TabControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </TabControl.ItemsPanel>
            </TabControl>
        </Grid>

        <Border Grid.Column="1" Background="#1E293B" CornerRadius="25" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="PANIER" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,0,0,20"/>

                <DataGrid x:Name="GridPanier" Grid.Row="1" Style="{StaticResource DarkPanierGrid}" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ARTICLE" Binding="{Binding NomPlat}" Width="*" Foreground="White"/>
                        <DataGridTextColumn Header="QTÉ" Binding="{Binding Quantite}" Width="45" Foreground="#FBBF24"/>
                        <DataGridTextColumn Header="PRIX" Binding="{Binding TotalLigne, StringFormat={}{0} DH}" Width="85" Foreground="White"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="#0F172A" CornerRadius="15" Padding="20" Margin="0,20">
                    <DockPanel>
                        <TextBlock Text="TOTAL" Foreground="#94A3B8" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotal" Text="0.00 DH" Foreground="White" FontSize="36" FontWeight="Black" HorizontalAlignment="Right"/>
                    </DockPanel>
                </Border>

                <StackPanel Grid.Row="3">
                    <Button Content="VALIDER L'ENCAISSEMENT" Style="{StaticResource ValiderButtonStyle}" Height="60" Click="BtnValider_Click" Margin="0,0,0,10"/>
                    <Button Content="SUPPRIMER L'ARTICLE" Style="{StaticResource SupprimerButtonStyle}" Height="50" Click="BtnRetirer_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>